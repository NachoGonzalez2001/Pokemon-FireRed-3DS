+@ 3DS port: Solar Power's cost at the end of a sunny turn (battle_mega.c)
+BattleScript_SolarPowerHurts::
+	orword gHitMarker, HITMARKER_IGNORE_SUBSTITUTE | HITMARKER_PASSIVE_DAMAGE
+	healthbarupdate BS_ATTACKER
+	datahpupdate BS_ATTACKER
+	printstring STRINGID_MEGA_SOLAR_POWER
+	waitmessage B_WAIT_TIME_LONG
+	tryfaintmon BS_ATTACKER
+	end3
+
+@ 3DS port: Magic Bounce sends a status move back (as Magic Coat, its own words)
+BattleScript_MagicBounce::
+	attackstring
+	ppreduce
+	pause B_WAIT_TIME_SHORT
+	printstring STRINGID_MEGA_MAGIC_BOUNCE
+	waitmessage B_WAIT_TIME_LONG
+	orword gHitMarker, HITMARKER_ATTACKSTRING_PRINTED | HITMARKER_NO_PPDEDUCT | HITMARKER_ALLOW_NO_PP
+	setmagiccoattarget BS_ATTACKER
+	return
+
+@ 3DS port: Mega Rayquaza's Delta Stream as it Mega Evolves
+BattleScript_DeltaStreamActivates::
+	printstring STRINGID_MEGA_DELTA_STREAM
+	waitmessage B_WAIT_TIME_LONG
+	return
