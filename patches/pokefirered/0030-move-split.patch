+bool8 MoveSplit_Modern(void)
+{
+    return CtrExtras_Get("move_split") != 0;
+}
+
+/* The category a move is shown with, under the setting: its own, or its
+ * type's (Curse's ??? type counts as physical, as the game's damage does). */
+u8 MoveSplit_Category(u16 move)
+{
+    u8 type;
+
+    if (move >= MOVES_COUNT || gBattleMoves[move].power == 0)
+        return MOVE_CATEGORY_STATUS;
+    if (MoveSplit_Modern())
+        return sCategories[move];
+    type = gBattleMoves[move].type;
+    return IS_TYPE_SPECIAL(type) ? MOVE_CATEGORY_SPECIAL : MOVE_CATEGORY_PHYSICAL;
+}
+
+/* In a battle: the move as this Pokémon uses it, whose type may have been
+ * changed (Aerilate and the other -ate abilities, Hidden Power, Weather
+ * Ball). CLASSIC follows that type, MODERN the move. */
+bool8 MoveSplit_IsPhysical(u8 battlerAtk, u16 move, u8 type)
+{
+    if (MoveSplit_Modern() && move < MOVES_COUNT)
+        return sCategories[move] == MOVE_CATEGORY_PHYSICAL;
+    return IS_TYPE_PHYSICAL(Mega_CategoryType(battlerAtk, move, type));
+}
+
+bool8 MoveSplit_IsSpecial(u8 battlerAtk, u16 move, u8 type)
+{
+    if (MoveSplit_Modern() && move < MOVES_COUNT)
+        return sCategories[move] == MOVE_CATEGORY_SPECIAL;
+    return IS_TYPE_SPECIAL(Mega_CategoryType(battlerAtk, move, type));
+}
