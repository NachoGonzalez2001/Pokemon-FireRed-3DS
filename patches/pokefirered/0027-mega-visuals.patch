+static const union AnimCmd sAnim_Orb2[] = { ANIMCMD_FRAME(2, 1), ANIMCMD_END };
+static const union AnimCmd sAnim_Orb3[] = { ANIMCMD_FRAME(3, 1), ANIMCMD_END };
+static const union AnimCmd sAnim_Orb4[] = { ANIMCMD_FRAME(4, 1), ANIMCMD_END };
+static const union AnimCmd sAnim_Orb5[] = { ANIMCMD_FRAME(5, 1), ANIMCMD_END };
+static const union AnimCmd *const sAnims_Orb[MEGA_FX_HUES] = {
+    sAnim_Orb0, sAnim_Orb1, sAnim_Orb2, sAnim_Orb3, sAnim_Orb4, sAnim_Orb5,
+};
+
+static void SpriteCB_MegaOrb(struct Sprite *sprite);
+static void SpriteCB_MegaRing(struct Sprite *sprite);
+static void SpriteCB_MegaShard(struct Sprite *sprite);
+
+static const struct SpriteTemplate sTemplate_MegaOrb = {
+    .tileTag = TAG_MEGA_FX_ORB, .paletteTag = TAG_MEGA_FX_PAL, .oam = &sOam_MegaFx8, .anims = sAnims_Orb,
+    .images = NULL, .affineAnims = gDummySpriteAffineAnimTable, .callback = SpriteCB_MegaOrb,
+};
+static const struct SpriteTemplate sTemplate_MegaRing = {
+    .tileTag = TAG_MEGA_FX_RING, .paletteTag = TAG_MEGA_FX_PAL, .oam = &sOam_MegaFxRing, .anims = gDummySpriteAnimTable,
+    .images = NULL, .affineAnims = gDummySpriteAffineAnimTable, .callback = SpriteCB_MegaRing,
+};
+static const struct SpriteTemplate sTemplate_MegaShard = {
+    .tileTag = TAG_MEGA_FX_SHARD, .paletteTag = TAG_MEGA_FX_PAL, .oam = &sOam_MegaFx8, .anims = gDummySpriteAnimTable,
+    .images = NULL, .affineAnims = gDummySpriteAffineAnimTable, .callback = SpriteCB_MegaShard,
+};
+
+static struct {
+    bool8 loaded;
+    u8 battler;
+    s16 x, y;      /* the middle of the Pokémon's picture */
+    u16 frame;
+    u32 dimMask;   /* the palettes the scene dims: all but the Pokémon's and the effect's */
+} sFx;
+
+/* An orb spirals in, faster as it nears, and goes out in the middle.
+ * data: 0 angle (0-255), 1 radius * 16, 2 delay, 3 turn speed */
+static void SpriteCB_MegaOrb(struct Sprite *sprite)
+{
+    if (sprite->data[2] > 0)
+    {
+        sprite->data[2]--;
+        sprite->invisible = TRUE;
+        return;
+    }
+    sprite->invisible = FALSE;
+    sprite->data[0] = (sprite->data[0] + sprite->data[3]) & 0xFF;
+    sprite->data[1] -= 16 + (80 * 16 - sprite->data[1]) / 20;
+    if (sprite->data[1] <= 4 * 16)
+    {
+        DestroySprite(sprite);
+        return;
+    }
+    sprite->x = sFx.x + Cos(sprite->data[0], sprite->data[1] / 16);
+    sprite->y = sFx.y + Sin(sprite->data[0], sprite->data[1] / 16) * 3 / 4;
+}
+
+/* The ring grows from small to round the whole Pokémon, then breathes.
+ * data: 0 frame */
+static void SpriteCB_MegaRing(struct Sprite *sprite)
+{
+    s32 size; /* 256: the picture's own size */
+    u16 inv;
+
+    sprite->data[0]++;
+    if (sprite->data[0] < 22)
+        size = 48 + (300 - 48) * sprite->data[0] / 22;
+    else
+        size = 280 + Sin((sprite->data[0] * 24) & 0xFF, 20);
+    inv = 0x10000 / size;
+    SetOamMatrix(sprite->oam.matrixNum, inv, 0, 0, inv);
+}
+
+/* A shard flies out from the middle and is gone.
+ * data: 0 angle, 1 speed * 16, 2 life, 3 distance * 16 */
+static void SpriteCB_MegaShard(struct Sprite *sprite)
+{
+    sprite->data[3] += sprite->data[1];
+    sprite->x2 = Cos(sprite->data[0], sprite->data[3] / 16);
+    sprite->y2 = Sin(sprite->data[0], sprite->data[3] / 16);
+    if (--sprite->data[2] == 0)
+        DestroySprite(sprite);
+    else if (sprite->data[2] < 8)
+        sprite->invisible = sprite->data[2] & 1;
+}
+
+static void MegaFx_Begin(u8 battler)
+{
+    struct SpriteSheet orbs = { gMegaFxOrbs, MEGA_FX_HUES * TILE_SIZE_4BPP, TAG_MEGA_FX_ORB };
+    struct SpriteSheet ring = { gMegaFxRing, 64 * TILE_SIZE_4BPP, TAG_MEGA_FX_RING };
+    struct SpriteSheet shard = { gMegaFxShard, TILE_SIZE_4BPP, TAG_MEGA_FX_SHARD };
+    struct SpritePalette pal = { gMegaFxPal, TAG_MEGA_FX_PAL };
+    u8 palNum;
+
+    sFx.battler = battler;
+    sFx.frame = 0;
+    sFx.x = GetBattlerSpriteCoord(battler, BATTLER_COORD_X_2);
+    sFx.y = GetBattlerSpriteCoord(battler, BATTLER_COORD_Y_PIC_OFFSET);
+    LoadSpriteSheet(&orbs);
+    LoadSpriteSheet(&ring);
+    LoadSpriteSheet(&shard);
+    palNum = LoadSpritePalette(&pal);
+    sFx.loaded = palNum != 0xFF;
+    sFx.dimMask = ~(1u << (16 + battler));
+    if (sFx.loaded)
+        sFx.dimMask &= ~(1u << (16 + palNum));
+}
+
+static void MegaFx_End(void)
+{
+    int i;
+
+    for (i = 0; i < MAX_SPRITES; i++)
+    {
+        struct Sprite *sprite = &gSprites[i];
+
+        if (!sprite->inUse)
+            continue;
+        if (sprite->template == &sTemplate_MegaRing)
+        {
+            FreeOamMatrix(sprite->oam.matrixNum);
+            DestroySprite(sprite);
+        }
+        else if (sprite->template == &sTemplate_MegaOrb || sprite->template == &sTemplate_MegaShard)
+        {
+            DestroySprite(sprite);
+        }
+    }
+    FreeSpriteTilesByTag(TAG_MEGA_FX_ORB);
+    FreeSpriteTilesByTag(TAG_MEGA_FX_RING);
+    FreeSpriteTilesByTag(TAG_MEGA_FX_SHARD);
+    FreeSpritePaletteByTag(TAG_MEGA_FX_PAL);
+    BlendPalettes(sFx.dimMask, 0, RGB_BLACK);
+    sFx.loaded = FALSE;
+}
+
+/* One frame of the effect; TRUE once it is over. The form changes at FX_BURST. */
+static bool8 MegaFx_Update(s8 form)
+{
+    u8 battler = sFx.battler;
+    u16 offset = OBJ_PLTT_ID(battler);
+    u16 t = sFx.frame++;
+    int i;
+
+    /* the scene dims, and comes back from the flash */
+    if (t <= FX_DIM_END)
+        BlendPalettes(sFx.dimMask, t * 9 / FX_DIM_END, RGB_BLACK);
+    else if (t > FX_BURST && t <= FX_FLASH_END)
+        BlendPalettes(sFx.dimMask, 16 - (t - FX_BURST) * 16 / (FX_FLASH_END - FX_BURST), RGB_WHITE);
+
+    /* the Pokémon shimmers, then turns white; after the burst its colours come back */
+    if (t < FX_WHITE_START)
+        BlendPalette(offset, 16, Sin((t * 16) & 0xFF, 4) + 4, RGB_WHITE);
+    else if (t < FX_BURST)
+        BlendPalette(offset, 16, min(16, 4 + (t - FX_WHITE_START) * 12 / (FX_BURST - FX_WHITE_START - 8)), RGB_WHITE);
+    else if (t > FX_BURST && t <= FX_FLASH_END)
+        BlendPalette(offset, 16, 16 - (t - FX_BURST) * 16 / (FX_FLASH_END - FX_BURST), RGB_WHITE);
+
+    if (t == FX_ORBS_START)
+    {
+        PlaySE(SE_M_COSMIC_POWER);
+        for (i = 0; sFx.loaded && i < MEGA_FX_ORBS; i++)
+        {
+            u8 id = CreateSprite(&sTemplate_MegaOrb, sFx.x, sFx.y, 1);
+
+            if (id == MAX_SPRITES)
+                break;
+            gSprites[id].data[0] = (i * 256 * 5 / MEGA_FX_ORBS) & 0xFF;
+            gSprites[id].data[1] = (64 + (i % 3) * 10) * 16;
+            gSprites[id].data[2] = (i * 7) % 26;
+            gSprites[id].data[3] = 5 + (i & 1);
+            gSprites[id].invisible = TRUE;
+            StartSpriteAnim(&gSprites[id], i % MEGA_FX_HUES);
+        }
+    }
+    if (t == FX_RING_START)
+    {
+        PlaySE(SE_M_REFLECT);
+        if (sFx.loaded)
+        {
+            u8 id = CreateSprite(&sTemplate_MegaRing, sFx.x, sFx.y, 0);
+
+            if (id != MAX_SPRITES)
+                SetOamMatrix(gSprites[id].oam.matrixNum, 0x10000 / 48, 0, 0, 0x10000 / 48);
+        }
+    }
+    if (t == FX_BURST)
+    {
+        for (i = 0; i < MAX_SPRITES; i++)
+            if (gSprites[i].inUse && gSprites[i].template == &sTemplate_MegaRing)
+            {
+                FreeOamMatrix(gSprites[i].oam.matrixNum);
+                DestroySprite(&gSprites[i]);
+            }
+        LoadFormPicture(battler, form, TRUE);
+        LoadFormPalette(battler, form);
+        BlendPalette(offset, 16, 16, RGB_WHITE);
+        BlendPalettes(sFx.dimMask, 16, RGB_WHITE);
+        for (i = 0; sFx.loaded && i < MEGA_FX_SHARDS; i++)
+        {
+            u8 id = CreateSprite(&sTemplate_MegaShard, sFx.x, sFx.y, 0);
+
+            if (id == MAX_SPRITES)
+                break;
+            gSprites[id].data[0] = (i * 256 / MEGA_FX_SHARDS + 8) & 0xFF;
+            gSprites[id].data[1] = 40 + (i % 3) * 12;
+            gSprites[id].data[2] = 24 + (i % 4) * 3;
+        }
+        PlaySE(SE_SHINY);
+    }
+    if (t == FX_FLASH_END)
+    {
+        CpuCopy32(&gPlttBufferUnfaded[offset], &gPlttBufferFaded[offset], PLTT_SIZE_4BPP);
+        PlayCry_Normal(gBattleMons[battler].species, GetBattlerSide(battler) == B_SIDE_PLAYER ? -25 : 25);
+    }
+    if (t < FX_END)
+        return FALSE;
+    MegaFx_End();
+    return TRUE;
+}
