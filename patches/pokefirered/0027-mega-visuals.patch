+};
+static const struct OamData sOam_MegaFxRing = {
+    .affineMode = ST_OAM_AFFINE_DOUBLE, .shape = SPRITE_SHAPE(64x64), .size = SPRITE_SIZE(64x64), .priority = 1,
+};
+
+static const union AnimCmd sAnim_Orb0[] = { ANIMCMD_FRAME(0, 1), ANIMCMD_END };
