+#define TAG_MEGA_FX_RING  0xD7A2
+#define TAG_MEGA_FX_SHARD 0xD7A3
+#define MEGA_FX_HUES 6
+#define MEGA_FX_ORBS 18
+#define MEGA_FX_SHARDS 10
+
+/* frames from the start */
+#define FX_DIM_END     16
+#define FX_ORBS_START  6
