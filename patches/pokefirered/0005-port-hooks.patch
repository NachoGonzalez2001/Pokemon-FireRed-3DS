+static void RenderBGScanline8bpp(int bgNum, uint16_t control, uint16_t hoffs, uint16_t voffs, int lineNum,
+                                 uint16_t *line, struct scanlineData *scanline, bool windowsEnabled,
+                                 bool insideWinIn, bool blend)
+{
