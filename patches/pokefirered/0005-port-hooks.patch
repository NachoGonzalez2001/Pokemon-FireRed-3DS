+    *mapGfx = sRegionMap_Gfx;
+    *mapTilemap = sTilemaps[region < REGIONMAP_COUNT ? region : REGIONMAP_KANTO];
+    *bgGfx = sBackground_Gfx;
+    *bgTilemap = sBackground_Tilemap;
+    *pal = sRegionMap_Pal;
+    *playerGfx = gSaveBlock2Ptr->playerGender == FEMALE ? sPlayerIcon_Leaf : sPlayerIcon_Red;
+    *playerPal = gSaveBlock2Ptr->playerGender == FEMALE ? sPlayerIcon_LeafPal : sPlayerIcon_RedPal;
+}
+
+// The player's map (REGIONMAP_*) and cell; a cell's centre is at
+// (8 * x + 36, 8 * y + 36) on the 240x160 map screen.
+u8 Port_GetRegionMapPlayer(s16 *x, s16 *y)
+{
+    struct MapCursor cursor = {0};
+    struct MapCursor *saved = sMapCursor;
+    u8 region = REGIONMAP_KANTO;
+    int i, j;
+
+    if (gMapHeader.regionMapSectionId >= SEVII_MAPSEC_START)
+    {
+        for (j = 0; j < (int)NELEMS(sSeviiMapsecs) && region == REGIONMAP_KANTO; j++)
+            for (i = 0; sSeviiMapsecs[j][i] != MAPSEC_NONE; i++)
+                if (gMapHeader.regionMapSectionId == sSeviiMapsecs[j][i])
+                {
+                    region = j + 1;
+                    break;
+                }
+    }
+    // The map screen's own state is read too (the selected map).
+    {
+        static struct RegionMap sPortRegionMap;
+        struct RegionMap *savedMap = sRegionMap;
+
+        sPortRegionMap.selectedRegion = region;
+        sPortRegionMap.playersRegion = region;
+        sRegionMap = &sPortRegionMap;
+        sMapCursor = &cursor;
+        GetPlayerPositionOnRegionMap_HandleOverrides();
+        sMapCursor = saved;
+        sRegionMap = savedMap;
+    }
+    *x = cursor.x;
+    *y = cursor.y;
+    return region;
+}
+#endif
