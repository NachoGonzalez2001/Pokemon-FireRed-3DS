+    yy = (lineNum + voffs) & 0x1FF;
+
+    // without mosaic the map entry and tile row change once per 8 pixels
+    {
+        uint16_t *rowmap = (uint16_t *)BG_SCREEN_ADDR(screenBaseBlock);
+        unsigned int tileY = yy & 7;
+        unsigned int x = 0;
+
+        if (yy > 255 && mapHeightInPixels > 256)
+            rowmap += (mapWidthInPixels > 256) ? 0x800 : 0x400;
+        rowmap += ((yy & 0xFF) / 8) * 32;
+
+        while (x < DISPLAY_WIDTH)
+        {
+            unsigned int xx = (((control & BGCNT_MOSAIC) ? applyBGHorizontalMosaicEffect(x) : x) + hoffs) & 0x1FF;
+            uint16_t *bgmap = rowmap + ((xx > 255 && mapWidthInPixels > 256) ? 0x400 : 0);
+            uint16_t entry = bgmap[(xx & 0xFF) / 8];
+            unsigned int row = (entry & (1 << 11)) ? 7 - tileY : tileY;
+            const uint8_t *tile = &bgtiles[(entry & 0x3FF) * 64 + row * 8];
+            unsigned int run = (control & BGCNT_MOSAIC) ? 1 : 8 - (xx & 7);
+
+            for (unsigned int k = 0; k < run && x < DISPLAY_WIDTH; k++, x++)
+            {
+                unsigned int tileX = (xx + k) & 7;
+                uint16_t color;
+                uint8_t pixel;
+                bool clr;
+
+                if (insideWinIn && !(scanline->winMask[x] & (1 << bgNum)))
+                    continue;
