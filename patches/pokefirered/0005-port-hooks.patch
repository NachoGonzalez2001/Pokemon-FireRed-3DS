+#ifdef PORT_BRIDGE
+// The 3DS bottom screen opens the start menu's screens. It asks for one of
+// the menu's actions and then presses START, so the request is served exactly
+// when and where the game would have opened the menu; the action then runs as
+// if chosen from it, without the menu being drawn. START pressed on its own
+// still opens the menu as usual.
+
+#define CTR_START_NONE 0xFF
+static u8 sCtrRequest = CTR_START_NONE;
+static bool8 sCtrReturning;
+
+static bool8 CtrStartMenu_IsReplaced(void)
+{
+    return sCtrReturning;
+}
+
+static void Task_CtrReturnToField(u8 taskId)
+{
+    if (FieldFadeTransitionBackgroundEffectIsFinished() == TRUE)
+    {
+        ClearPlayerHeldMovementAndUnfreezeObjectEvents();
+        UnlockPlayerFieldControls();
+        DestroyTask(taskId);
+    }
+}
+
+static bool8 CtrFieldCB2_ReturnToField(void)
+{
+    sCtrReturning = FALSE;
+    FadeInFromBlack();
+    CreateTask(Task_CtrReturnToField, 80);
+    LockPlayerFieldControls();
+    return TRUE;
+}
+
+static void Task_CtrStartMenuAction(u8 taskId)
+{
+    if (sStartMenuCallback() == TRUE)
+        DestroyTask(taskId);
+}
+
+static bool8 CtrStartMenu_Divert(void)
+{
+    u8 action = sCtrRequest;
+
+    if (action == CTR_START_NONE)
+        return FALSE;
+    sCtrRequest = CTR_START_NONE;
+    if (IsUpdateLinkStateCBActive() || InUnionRoom() || GetSafariZoneFlag())
+        return FALSE;
+    if (action == STARTMENU_POKEDEX && GetNationalPokedexCount(0) == 0)
+        return FALSE;
+
+    FreezeObjectEvents();
+    HandleEnforcedLookDirectionOnPlayerStopMoving();
+    StopPlayerAvatar();
+    LockPlayerFieldControls();
+    sStartMenuCallback = sStartMenuActionTable[action].func.u8_void;
+    if (action == STARTMENU_SAVE)
+    {
+        // The save dialog ends with the start menu's own cleanup or redraw.
+        sStartMenuCallback = StartCB_Save1;
+    }
+    else
+    {
+        sCtrReturning = TRUE;
+        StopPokemonLeagueLightingEffectTask();
+        FadeScreen(FADE_TO_BLACK, 0);
+    }
+    CreateTask(Task_CtrStartMenuAction, 80);
+    return TRUE;
+}
+
+// STARTMENU_* to open on the next START press.
+void CtrStartMenu_Request(u8 action)
+{
+    sCtrRequest = action;
+}
+
+bool8 CtrStartMenu_Pending(void)
+{
+    return sCtrRequest != CTR_START_NONE;
+}
+
+// One of the bottom screen's actions (or its save dialog) is running.
+bool8 CtrStartMenu_Busy(void)
+{
+    return FuncIsActiveTask(Task_CtrStartMenuAction);
+}
+#endif
