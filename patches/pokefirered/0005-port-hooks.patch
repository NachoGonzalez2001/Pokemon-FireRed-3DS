new file mode 100644
index 0000000000000000000000000000000000000000..750b979cb733bee78011e2b8099108bb1877d88f
--- /dev/null
+++ b/tools/dev/cycle.ps1
@@ -0,0 +1,26 @@
+﻿param([int]$Wait = 15, [string]$Shot = "boot", [string]$Keys = "")
+# Build the 3dsx, run it in Azahar, capture, close, and print the port log
+# tail plus the emulator's distinct errors.
+$P = 'C:\Users\ignac\OneDrive\Escritorio\pokemon voxel mod\pokefirered-3ds'
+$scratch = ($PSScriptRoot -replace '\\','/')
+$boot = python "$P\tools\bootstrap.py" --dir C:\fr3ds\upstream 2>&1
+if ($LASTEXITCODE -ne 0) { $boot; "bootstrap failed: not building"; exit 1 }
+$boot | Select-Object -Last 1
+# Every frame dump from a previous run is stale
+Remove-Item "$env:APPDATA\Azahar\sdmc\3ds\emerald3ds\frame_*.raw" -ErrorAction SilentlyContinue
+$env:MSYSTEM = 'MSYS'
+& C:\devkitPro\msys2\usr\bin\bash.exe -l "$P\tools\dkp.sh" /c/fr3ds bash "$scratch/mk.sh" all all -j4
+if (-not (Test-Path C:\fr3ds\upstream\3ds_port\firered3ds.3dsx)) { "no 3dsx"; exit 1 }
+$sd = "$env:APPDATA\Azahar\sdmc\3ds\emerald3ds"
+Remove-Item "$sd\port.log" -ErrorAction SilentlyContinue
+& "$P\3ds_port\scripts\emu\run.ps1" -App C:\fr3ds\upstream\3ds_port\firered3ds.3dsx -Out "$P\build\$Shot.png" -Wait $Wait -Keys $Keys -Keep
+Get-Process azahar -ErrorAction SilentlyContinue | ForEach-Object { $_.CloseMainWindow() | Out-Null }
+Start-Sleep -Milliseconds 2500
+Get-Process azahar -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue
+"---- port.log"
+if (Test-Path "$sd\port.log") { Get-Content "$sd\port.log" -Tail 40 }
+"---- emulator errors"
+$f = "$env:APPDATA\Azahar\log\azahar_log.txt"
+Select-String -Path $f -Pattern '<Error>|<Critical>' | Where-Object { $_.Line -notmatch 'update_checker|ClCertA|title id|ConfigureNew3DSCPU|port-prev|Rename|Delay generator' } |
+  ForEach-Object { ($_.Line -replace '^\[\s*[\d.]+\]\s*','') -replace '@ 0x[0-9A-F]+','@ ...' } |
+  Group-Object | Sort-Object Count -Descending | Select-Object -First 15 | ForEach-Object { "{0,6}x {1}" -f $_.Count, $_.Name.Substring(0, [Math]::Min(170, $_.Name.Length)) }
diff --git a/tools/dev/merge3.py b/tools/dev/merge3.py
new file mode 100644
index 0000000000000000000000000000000000000000..bf16665460b8f450185b55587c942177b69022a1
--- /dev/null
+++ b/tools/dev/merge3.py
@@ -0,0 +1,54 @@
+"""3-way merge Emerald-port changes into FireRed files.
+
+usage: merge3.py <emerald_ref_root> <emerald_patch> <fr_tree> <relpath>...
+
+For each relpath: base = pokeemerald original, ours = base + the Emerald port
+patch hunks for that file, theirs = FireRed's committed version (BOM removed).
+The merged result (with conflict markers if any) is written into fr_tree.
+"""
+import os
+import re
+import subprocess
+import sys
+import tempfile
+
+ref, patch, tree = sys.argv[1:4]
+files = sys.argv[4:]
+text = open(patch, encoding="utf-8", errors="surrogateescape").read()
+chunks = re.split(r"(?m)^(?=diff --git )", text)
+
+
+def git(*a, cwd=None, inp=None):
+    return subprocess.run(["git", "-c", "core.autocrlf=false", *a], cwd=cwd, input=inp,
+                          capture_output=True)
+
+
+for rel in files:
+    chunk = next((c for c in chunks if c.startswith("diff --git a/%s b/" % rel)), None)
+    if chunk is None:
+        print("%s: no hunks in patch" % rel)
+        continue
+    with tempfile.TemporaryDirectory() as td:
+        base = open(os.path.join(ref, rel), "rb").read().replace(b"\r\n", b"\n")
+        os.makedirs(os.path.join(td, os.path.dirname(rel)), exist_ok=True)
+        open(os.path.join(td, rel), "wb").write(base)
+        git("init", "-q", cwd=td)
+        r = git("apply", "--whitespace=nowarn", "-", cwd=td,
+                inp=chunk.encode("utf-8", "surrogateescape"))
+        if r.returncode:
+            print("%s: patch does not apply to the Emerald base: %s" % (rel, r.stderr.decode()[:300]))
+            continue
+        ours = os.path.join(td, rel)
+        basef = os.path.join(td, "base.tmp")
+        open(basef, "wb").write(base)
+        theirs = git("show", "HEAD:" + rel, cwd=tree).stdout
+        if theirs.startswith(b"\xef\xbb\xbf"):
+            theirs = theirs[3:]
+        theirsf = os.path.join(td, "theirs.tmp")
+        open(theirsf, "wb").write(theirs.replace(b"\r\n", b"\n"))
+        # merge-file writes into its first argument
+        r = subprocess.run(["git", "merge-file", "-L", "emerald-port", "-L", "emerald", "-L", "firered",
+                            ours, basef, theirsf], capture_output=True)
+        out = open(ours, "rb").read()
+        open(os.path.join(tree, rel), "wb").write(out)
+        print("%s: %s" % (rel, "clean" if r.returncode == 0 else "%d conflict(s)" % r.returncode))
