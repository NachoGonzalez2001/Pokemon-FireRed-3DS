+    unsigned int screenBaseBlock = (control >> 8) & 0x1F;
+    unsigned int mapWidthInPixels = bgMapSizes[control >> 14][0] * 8;
+    unsigned int mapHeightInPixels = bgMapSizes[control >> 14][1] * 8;
+    uint8_t *bgtiles = (uint8_t *)BG_CHAR_ADDR(charBaseBlock);
+    uint16_t *pal = (uint16_t *)PLTT;
+    uint16_t *mask = scanline->bgMask;
+    uint8_t blendMode = (REG_BLDCNT >> 6) & 3;
+    unsigned int yy;
+
+    if (windowsEnabled && !insideWinIn && !(REG_WINOUT & (1 << bgNum)))
+        return;
+    if (control & BGCNT_MOSAIC)
+        lineNum = applyBGVerticalMosaicEffect(lineNum);
+    yy = (lineNum + voffs) & 0x1FF;
+
+    // without mosaic the map entry and tile row change once per 8 pixels
+    {
+        uint16_t *rowmap = (uint16_t *)BG_SCREEN_ADDR(screenBaseBlock);
+        unsigned int tileY = yy & 7;
+        unsigned int x = 0;
+
+        if (yy > 255 && mapHeightInPixels > 256)
+            rowmap += (mapWidthInPixels > 256) ? 0x800 : 0x400;
+        rowmap += ((yy & 0xFF) / 8) * 32;
+
+        while (x < DISPLAY_WIDTH)
+        {
+            unsigned int xx = (((control & BGCNT_MOSAIC) ? applyBGHorizontalMosaicEffect(x) : x) + hoffs) & 0x1FF;
+            uint16_t *bgmap = rowmap + ((xx > 255 && mapWidthInPixels > 256) ? 0x400 : 0);
+            uint16_t entry = bgmap[(xx & 0xFF) / 8];
+            unsigned int row = (entry & (1 << 11)) ? 7 - tileY : tileY;
+            const uint8_t *tile = &bgtiles[(entry & 0x3FF) * 64 + row * 8];
+            unsigned int run = (control & BGCNT_MOSAIC) ? 1 : 8 - (xx & 7);
+
+            for (unsigned int k = 0; k < run && x < DISPLAY_WIDTH; k++, x++)
+            {
+                unsigned int tileX = (xx + k) & 7;
+                uint16_t color;
+                uint8_t pixel;
+                bool clr;
+
+                if (insideWinIn && !(scanline->winMask[x] & (1 << bgNum)))
+                    continue;
+                pixel = tile[(entry & (1 << 10)) ? 7 - tileX : tileX];
+                if (pixel == 0)
+                    continue;
+                color = pal[pixel];
+                if (blend)
+                {
+                    clr = insideWinIn ? (scanline->winMask[x] & WINMASK_CLR) != 0
+                                      : (!windowsEnabled || (REG_WINOUT & WINOUT_WIN01_CLR));
+                    if (clr)
+                    {
+                        switch (blendMode)
+                        {
+                        case 1:
+                            if (mask[x] & (REG_BLDCNT >> 8))
+                                color = alphaBlendColor(color, line[x]);
+                            break;
+                        case 2:
+                            color = alphaBrightnessIncrease(color);
+                            break;
+                        case 3:
+                            color = alphaBrightnessDecrease(color);
+                            break;
+                        }
+                    }
+                }
+                line[x] = color | 0x8000;
+                mask[x] = 1 << bgNum;
+            }
+        }
+    }
+}
