+#!/bin/bash
+# mk.sh <logname> <make args...>: run make in the port dir, log, summarize errors
+cd /c/fr3ds/upstream/3ds_port
+log=/c/fr3ds/$1.log; shift
+make "$@" > "$log" 2>&1
+code=$?
+echo "make exit=$code"
+grep -E "error:|undefined reference|Error:|multiple definition|\*\*\*" "$log" \
+  | sed -E 's/^.*(src\/|include\/|data\/)/\1/' | sed -E 's/^.*: (undefined reference to)/\1/' \
+  | cut -c1-200 | sort | uniq -c | sort -rn | head -n 60
diff --git a/tools/dev/raw2png.py b/tools/dev/raw2png.py
new file mode 100644
index 0000000000000000000000000000000000000000..69013d490aa3ce4844f4adc3904d621aee9b08aa
--- /dev/null
+++ b/tools/dev/raw2png.py
@@ -0,0 +1,17 @@
+import struct, sys
+from PIL import Image
+raw = open(sys.argv[1], "rb").read()
+W, H = 240, 160
+px = struct.unpack("<%dH" % (W * H), raw[:W * H * 2])
+img = Image.new("RGB", (W, H))
+img.putdata([((c & 31) << 3, ((c >> 5) & 31) << 3, ((c >> 10) & 31) << 3) for c in px])
+img.resize((W * 3, H * 3), Image.NEAREST).save(sys.argv[2])
+regs = struct.unpack("<48H", raw[W * H * 2:W * H * 2 + 0x60])
+pal = struct.unpack("<32H", raw[W * H * 2 + 0x60:W * H * 2 + 0xA0])
+print("nonzero pixels:", sum(1 for c in px if c & 0x7FFF), "distinct:", len(set(c & 0x7FFF for c in px)))
+print("regs:", " ".join("%04x" % r for r in regs[:16]))
+print("DISPCNT=%04x BG0..3CNT=%04x %04x %04x %04x WIN0H=%04x WIN1H=%04x WIN0V=%04x WIN1V=%04x "
+      "WININ=%04x WINOUT=%04x MOSAIC=%04x BLDCNT=%04x BLDALPHA=%04x BLDY=%04x"
+      % (regs[0], regs[4], regs[5], regs[6], regs[7], regs[0x20], regs[0x21], regs[0x22], regs[0x23],
+         regs[0x24], regs[0x25], regs[0x26], regs[0x28], regs[0x29], regs[0x2A]))
+print("pal:", " ".join("%04x" % p for p in pal))
diff --git a/tools/dev/sizeof_scan.py b/tools/dev/sizeof_scan.py
new file mode 100644
index 0000000000000000000000000000000000000000..197fd33bbda28c34c8a47617b513243c711b050b
--- /dev/null
+++ b/tools/dev/sizeof_scan.py
@@ -0,0 +1,29 @@
+"""List sizeof() uses on INCBIN arrays (one-element stubs in the 3DS build).
+
+    python tools/dev/sizeof_scan.py [--all]
+
+Without --all, LoadPalette calls are left out (palette.c resolves those).
+"""
+import pathlib
+import re
+import sys
+
+root = pathlib.Path(r"C:\fr3ds\upstream\src")
+syms = set()
+for p in list(root.rglob("*.c")) + list(root.rglob("*.h")):
+    t = p.read_text(encoding="utf-8", errors="ignore")
+    for m in re.finditer(r"(\w+)\s*(?:\[[^\]]*\])+\s*=\s*INCBIN_[US]\d+\s*\(", t):
+        syms.add(m.group(1))
+show_all = "--all" in sys.argv
+count = 0
+for p in sorted(root.rglob("*.c")):
+    lines = p.read_text(encoding="utf-8", errors="ignore").splitlines()
+    for i, line in enumerate(lines, 1):
+        for m in re.finditer(r"sizeof\s*\(\s*(\w+)\s*\)", line):
+            if m.group(1) not in syms:
+                continue
+            if not show_all and "LoadPalette" in line:
+                continue
+            count += 1
+            print("%s:%d: %s" % (p.name, i, line.strip()))
+print("total:", count)
diff --git a/tools/dev/take_ours.py b/tools/dev/take_ours.py
new file mode 100644
index 0000000000000000000000000000000000000000..08675d1093f74dae9894ddb1a722aaf0c1f91a83
--- /dev/null
+++ b/tools/dev/take_ours.py
@@ -0,0 +1,9 @@
+"""Resolve merge-file conflict blocks by keeping the first (port) side."""
+import re
+import sys
+
+for path in sys.argv[1:]:
+    t = open(path, encoding="utf-8", errors="surrogateescape").read()
+    t, n = re.subn(r"<<<<<<< [^\n]*\n(.*?)=======\n.*?>>>>>>> [^\n]*\n", r"\1", t, flags=re.S)
+    open(path, "w", encoding="utf-8", errors="surrogateescape", newline="\n").write(t)
+    print(path, n, "resolved")
