+    unsigned int mapWidthInPixels = bgMapSizes[control >> 14][0] * 8;
+    unsigned int mapHeightInPixels = bgMapSizes[control >> 14][1] * 8;
+    uint8_t *bgtiles = (uint8_t *)BG_CHAR_ADDR(charBaseBlock);
