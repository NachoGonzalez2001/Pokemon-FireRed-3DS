+void Port_DecompressGlyph(u8 fontId, u16 glyphId)
+{
+    u8 fg = GetLastTextColor(0), bg = GetLastTextColor(2), shadow = GetLastTextColor(1);
+
+    GenerateFontHalfRowLookupTable(1, 0, 2);
+    switch (fontId)
+    {
+    case FONT_SMALL:
+        DecompressGlyph_Small(glyphId, FALSE);
+        break;
+    case FONT_MALE:
+        DecompressGlyph_Male(glyphId, FALSE);
+        break;
+    case FONT_FEMALE:
+        DecompressGlyph_Female(glyphId, FALSE);
+        break;
+    default:
+        DecompressGlyph_Normal(glyphId, FALSE);
+        break;
+    }
+    GenerateFontHalfRowLookupTable(fg, bg, shadow);
+}
