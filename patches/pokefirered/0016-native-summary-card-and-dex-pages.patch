+ * GBA picture (fr_bottom_ui.c). */
+const struct PokedexEntry *Port_DexEntry(u16 natNum)
+{
+    return &gPokedexEntries[natNum];
+}
+
+bool8 Port_DexHasPage(void)
+{
+    if (sPokedexScreenData == NULL)
+        return FALSE;
+    if (FuncIsActiveTask(Task_PokedexScreen) || FuncIsActiveTask(Task_DexScreen_NumericalOrder) || FuncIsActiveTask(Task_DexScreen_CharacteristicOrder))
+        return TRUE;
+    return FuncIsActiveTask(Task_DexScreen_ShowMonPage) && sPokedexScreenData->state < 7;
+}
+
+bool8 Port_DexGetView(struct PortDexView *view)
+{
+    u16 scroll, row;
+
+    if (sPokedexScreenData == NULL)
+        return FALSE;
+    view->species = sPokedexScreenData->dexSpecies;
+    view->unlocked = sPokedexScreenData->unlockedCategories;
+    view->national = IsNationalPokedexEnabled();
+    view->seenKanto = sPokedexScreenData->numSeenKanto;
+    view->ownedKanto = sPokedexScreenData->numOwnedKanto;
+    view->seenNational = sPokedexScreenData->numSeenNational;
+    view->ownedNational = sPokedexScreenData->numOwnedNational;
+    if (FuncIsActiveTask(Task_DexScreen_ShowMonPage))
+    {
+        view->mode = PORT_DEX_ENTRY;
+        return sPokedexScreenData->state == 5;
+    }
+    if (sPokedexScreenData->state != 6)
+        return FALSE;
+    if (FuncIsActiveTask(Task_PokedexScreen))
+    {
+        const struct ListMenu *list = (const struct ListMenu *)gTasks[sPokedexScreenData->modeSelectListMenuId].data;
+
+        view->mode = PORT_DEX_TOP;
+        view->listTask = sPokedexScreenData->modeSelectListMenuId;
+        view->items = list->template.items;
+        view->count = list->template.totalItems;
+    }
+    else if (FuncIsActiveTask(Task_DexScreen_NumericalOrder) || FuncIsActiveTask(Task_DexScreen_CharacteristicOrder))
+    {
+        view->mode = PORT_DEX_LIST;
+        view->listTask = sPokedexScreenData->orderedListMenuTaskId;
+        view->items = sPokedexScreenData->listItems;
+        view->count = sPokedexScreenData->orderedDexCount;
+    }
+    else
+        return FALSE;
+    ListMenuGetScrollAndRow(view->listTask, &scroll, &row);
+    view->cursor = scroll + row;
+    return TRUE;
+}
+#endif
