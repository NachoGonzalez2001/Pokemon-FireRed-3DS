+    view->level = s->levelStrBuf;
+    view->hp = s->curHpStrBuf;
+    view->expPoints = s->expPointsStrBuf;
+    view->expNext = s->expToNextLevelStrBuf;
+    view->abilityName = s->abilityNameStrBuf;
+    view->abilityDesc = s->abilityDescStrBuf;
