diff --git a/src/list_menu.c b/src/list_menu.c
index 372de1e70bc75c231c21eebf22a136623be5594b..1e5379184c94ea95b05c39a3fe31c0c3bf077767 100644
--- a/src/list_menu.c
+++ b/src/list_menu.c
@@ -762,3 +762,22 @@ void BlitMenuInfoIcon(u8 windowId, u8 iconId, u16 x, u16 y)
 {
     BlitBitmapRectToWindow(windowId, &PORT_RES(gMenuInfoElements_Gfx)[sMenuInfoIcons[iconId].offset * TILE_SIZE_4BPP], 0, 0, 128, 128, x, y, sMenuInfoIcons[iconId].width, sMenuInfoIcons[iconId].height);
 }
+
+#ifdef PORT_BRIDGE
+/* A tap on a row of a list (fr_bottom_ui.c). In a list menu cursorPos is the
+ * scroll and itemsAbove the row. */
+void Port_ListSetCursor(u8 listTaskId, u16 index)
+{
+    struct ListMenu *list = (struct ListMenu *)gTasks[listTaskId].data;
+
+    if (index >= list->template.totalItems || index == list->cursorPos + list->itemsAbove)
+        return;
+    if (index < list->cursorPos)
+        list->cursorPos = index;
+    else if (index >= list->cursorPos + list->template.maxShowed)
+        list->cursorPos = index - list->template.maxShowed + 1;
+    list->itemsAbove = index - list->cursorPos;
+    RedrawListMenu(listTaskId);
+    ListMenuCallSelectionChangedCallback(list, FALSE);
+}
+#endif
