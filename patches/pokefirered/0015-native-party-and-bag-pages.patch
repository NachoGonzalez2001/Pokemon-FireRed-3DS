+bool8 Port_BagGetView(struct PortBagView *view)
+{
+    u8 i;
+
+    if (sBagMenuDisplay == NULL)
+        return FALSE;
+    if (FuncIsActiveTask(Task_BagMenu_HandleInput))
+        view->mode = PORT_MENU_LIST;
+    else if (FuncIsActiveTask(Task_FieldItemContextMenuHandleInput))
+        view->mode = PORT_MENU_ACTIONS;
+    else if (FuncIsActiveTask(Task_SelectQuantityToToss) || FuncIsActiveTask(Task_SelectQuantityToSell) || FuncIsActiveTask(Task_SelectQuantityToDeposit))
+        view->mode = PORT_MENU_QUANTITY;
+    else
+        view->mode = PORT_MENU_OTHER;
+    view->pocket = gBagMenuState.pocket;
+    view->nItems = sBagMenuDisplay->nItems[gBagMenuState.pocket];
+    view->cursor = gBagMenuState.cursorPos[gBagMenuState.pocket] + gBagMenuState.itemsAbove[gBagMenuState.pocket];
+    view->numActions = 0;
+    if (view->mode == PORT_MENU_ACTIONS)
+    {
+        // CANCEL is the page's BACK key
+        for (i = 0; i < sContextMenuNumItems && view->numActions < ARRAY_COUNT(view->actions); i++)
+            if (sContextMenuItemsPtr[i] != ITEMMENUACTION_CANCEL)
+            {
+                view->actions[view->numActions] = sItemMenuContextActions[sContextMenuItemsPtr[i]].text;
+                view->actionRow[view->numActions++] = i;
+            }
+    }
+    for (i = 0; i < ARRAY_COUNT(view->windows); i++)
+        view->windows[i] = Port_BagOpenWindow(i);
+    if (view->mode == PORT_MENU_ACTIONS)
+        view->windows[10] = view->windows[6] = PORT_NO_WINDOW; // the page's keys and description
+    return TRUE;
+}
+
+void Port_BagMoveCursor(u16 index)
+{
+    u8 taskId = FindTaskIdByFunc(Task_BagMenu_HandleInput);
+    struct ListMenu *list;
+
+    if (taskId == TASK_NONE)
+        return;
+    list = (struct ListMenu *)gTasks[gTasks[taskId].data[0]].data;
+    if (index >= list->template.totalItems || index == list->cursorPos + list->itemsAbove)
+        return;
+    // in this list cursorPos is the scroll and itemsAbove the row
+    if (index < list->cursorPos)
+        list->cursorPos = index;
+    else if (index >= list->cursorPos + list->template.maxShowed)
+        list->cursorPos = index - list->template.maxShowed + 1;
+    list->itemsAbove = index - list->cursorPos;
+    RedrawListMenu(gTasks[taskId].data[0]);
+    if (list->template.moveCursorFunc != NULL)
+        list->template.moveCursorFunc(list->template.items[index].index, FALSE, list);
+    gBagMenuState.cursorPos[gBagMenuState.pocket] = list->cursorPos;
+    gBagMenuState.itemsAbove[gBagMenuState.pocket] = list->itemsAbove;
+}
+#endif
