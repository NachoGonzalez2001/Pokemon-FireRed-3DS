+// 3DS port: the player's diagonal steps. The step is the normal one along
+// the diagonal vector; the player still faces the step's north or south, so
+// the walk cycle, footprints and what is "in front" stay the four-way ones.
+static void InitDiagonalStep(struct ObjectEvent *objectEvent, struct Sprite *sprite, u8 direction, bool8 run)
+{
+    if (run)
+        StartRunningAnim(objectEvent, sprite, direction);
+    else
+        InitMovementNormal(objectEvent, sprite, direction, MOVE_SPEED_NORMAL);
+    objectEvent->facingDirection = (direction == DIR_NORTHWEST || direction == DIR_NORTHEAST) ? DIR_NORTH : DIR_SOUTH;
+}
+
+static bool8 MovementAction_Diagonal_Step1(struct ObjectEvent *objectEvent, struct Sprite *sprite)
+{
+    if (UpdateMovementNormal(objectEvent, sprite))
+    {
+        sprite->data[2] = 2;
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static bool8 MovementAction_WalkNormalDiagonalDownLeft_Step0(struct ObjectEvent *objectEvent, struct Sprite *sprite)
+{
+    InitDiagonalStep(objectEvent, sprite, DIR_SOUTHWEST, FALSE);
+    return MovementAction_Diagonal_Step1(objectEvent, sprite);
+}
+
+static bool8 MovementAction_WalkNormalDiagonalDownRight_Step0(struct ObjectEvent *objectEvent, struct Sprite *sprite)
+{
+    InitDiagonalStep(objectEvent, sprite, DIR_SOUTHEAST, FALSE);
+    return MovementAction_Diagonal_Step1(objectEvent, sprite);
+}
+
+static bool8 MovementAction_WalkNormalDiagonalUpLeft_Step0(struct ObjectEvent *objectEvent, struct Sprite *sprite)
+{
+    InitDiagonalStep(objectEvent, sprite, DIR_NORTHWEST, FALSE);
+    return MovementAction_Diagonal_Step1(objectEvent, sprite);
+}
+
+static bool8 MovementAction_WalkNormalDiagonalUpRight_Step0(struct ObjectEvent *objectEvent, struct Sprite *sprite)
+{
+    InitDiagonalStep(objectEvent, sprite, DIR_NORTHEAST, FALSE);
+    return MovementAction_Diagonal_Step1(objectEvent, sprite);
+}
+
+static bool8 MovementAction_PlayerRunDiagonalDownLeft_Step0(struct ObjectEvent *objectEvent, struct Sprite *sprite)
+{
+    InitDiagonalStep(objectEvent, sprite, DIR_SOUTHWEST, TRUE);
+    return MovementAction_Diagonal_Step1(objectEvent, sprite);
+}
+
+static bool8 MovementAction_PlayerRunDiagonalDownRight_Step0(struct ObjectEvent *objectEvent, struct Sprite *sprite)
+{
+    InitDiagonalStep(objectEvent, sprite, DIR_SOUTHEAST, TRUE);
+    return MovementAction_Diagonal_Step1(objectEvent, sprite);
+}
+
+static bool8 MovementAction_PlayerRunDiagonalUpLeft_Step0(struct ObjectEvent *objectEvent, struct Sprite *sprite)
+{
+    InitDiagonalStep(objectEvent, sprite, DIR_NORTHWEST, TRUE);
+    return MovementAction_Diagonal_Step1(objectEvent, sprite);
+}
+
+static bool8 MovementAction_PlayerRunDiagonalUpRight_Step0(struct ObjectEvent *objectEvent, struct Sprite *sprite)
+{
+    InitDiagonalStep(objectEvent, sprite, DIR_NORTHEAST, TRUE);
+    return MovementAction_Diagonal_Step1(objectEvent, sprite);
+}
