+    [DIR_NORTHWEST - DIR_SOUTHWEST] = MOVEMENT_ACTION_PLAYER_RUN_DIAGONAL_UP_LEFT,
+    [DIR_NORTHEAST - DIR_SOUTHWEST] = MOVEMENT_ACTION_PLAYER_RUN_DIAGONAL_UP_RIGHT,
+};
+
+static u8 PlayerDiagonalInput(u16 heldKeys)
+{
+    u8 vertical = 0, horizontal = 0;
+
+    if (heldKeys & DPAD_UP)
+        vertical = DIR_NORTH;
+    else if (heldKeys & DPAD_DOWN)
+        vertical = DIR_SOUTH;
+    if (heldKeys & DPAD_LEFT)
+        horizontal = DIR_WEST;
+    else if (heldKeys & DPAD_RIGHT)
+        horizontal = DIR_EAST;
+    if (vertical && horizontal)
+    {
+        if (vertical == DIR_NORTH)
+            return horizontal == DIR_WEST ? DIR_NORTHWEST : DIR_NORTHEAST;
+        return horizontal == DIR_WEST ? DIR_SOUTHWEST : DIR_SOUTHEAST;
+    }
+    return CtrPlayer_StickDiagonal();
+}
+
+// Plain ground: nothing a step onto it does but stand there.
+static bool8 IsPlainForDiagonalStep(s16 x, s16 y)
+{
+    u8 behavior = MapGridGetMetatileBehaviorAt(x, y);
+
+    return !MetatileBehavior_IsForcedMovementTile(behavior)
+        && !MetatileBehavior_IsDirectionalStairWarp(behavior)
+        && !MetatileBehavior_IsWarpDoor(behavior)
+        && !MetatileBehavior_IsArrowWarp(behavior)
+        && !MetatileBehavior_IsLadder(behavior)
+        && !MetatileBehavior_IsEscalator(behavior)
+        && !MetatileBehavior_IsRockStairs(behavior)
+        && !MetatileBehavior_IsSpinTile(behavior)
+        && !MetatileBehavior_IsIce_2(behavior);
+}
+
+static bool8 IsOpenForDiagonalStep(struct ObjectEvent *player, s16 x, s16 y, u8 direction)
+{
+    return GetCollisionAtCoords(player, x, y, direction) == COLLISION_NONE
+        && GetLedgeJumpDirection(x, y, direction) == DIR_NONE
+        && IsPlainForDiagonalStep(x, y);
+}
+
+// A diagonal step where it fits; where it does not, `direction` becomes the
+// one of its two arms that is open (sliding along a wall), the input's own
+// first if both are.
+static bool8 TryMovePlayerDiagonally(u16 heldKeys, u8 *cardinal)
+{
+    struct ObjectEvent *player = &gObjectEvents[gPlayerAvatar.objectEventId];
+    u8 direction, vertical, horizontal;
+    s16 x, y, dx, dy;
+    bool8 run;
+
+    if (QL_IS_PLAYBACK_STATE || (gPlayerAvatar.flags & PLAYER_AVATAR_FLAG_SURFING))
+        return FALSE;
+    direction = PlayerDiagonalInput(heldKeys);
+    if (direction < DIR_SOUTHWEST || direction > DIR_NORTHEAST)
+        return FALSE;
+    vertical = (direction == DIR_NORTHWEST || direction == DIR_NORTHEAST) ? DIR_NORTH : DIR_SOUTH;
+    horizontal = (direction == DIR_SOUTHWEST || direction == DIR_NORTHWEST) ? DIR_WEST : DIR_EAST;
+    dx = horizontal == DIR_WEST ? -1 : 1;
+    dy = vertical == DIR_NORTH ? -1 : 1;
+    x = player->currentCoords.x;
+    y = player->currentCoords.y;
+    // both ways round the corner open, the corner itself plain: never a
+    // corner cut through a wall, a ledge, a door or the water's edge
+    if (!IsPlainForDiagonalStep(x, y)
+     || !IsOpenForDiagonalStep(player, x + dx, y, horizontal)
+     || !IsOpenForDiagonalStep(player, x, y + dy, vertical)
+     || !IsOpenForDiagonalStep(player, x + dx, y + dy, vertical)
+     || !IsOpenForDiagonalStep(player, x + dx, y + dy, horizontal))
+    {
+        bool8 verticalOpen = GetCollisionAtCoords(player, x, y + dy, vertical) == COLLISION_NONE;
+        bool8 horizontalOpen = GetCollisionAtCoords(player, x + dx, y, horizontal) == COLLISION_NONE;
+
+        if (*cardinal == vertical && !verticalOpen && horizontalOpen)
+            *cardinal = horizontal;
+        else if (*cardinal == horizontal && !horizontalOpen && verticalOpen)
+            *cardinal = vertical;
+        return FALSE;
+    }
+
+    if (CtrPlayer_RunAlways())
+        heldKeys ^= B_BUTTON;
+    run = (heldKeys & B_BUTTON) && FlagGet(FLAG_SYS_B_DASH)
+       && !IsRunningDisallowed(player->currentMetatileBehavior);
+    gPlayerAvatar.runningState = MOVING;
+    if (run)
+    {
+        PlayerSetAnimId(sRunDiagonalMovementActions[direction - DIR_SOUTHWEST], 0);
+        gPlayerAvatar.flags |= PLAYER_AVATAR_FLAG_DASH;
+    }
+    else
+    {
+        PlayerSetAnimId(sWalkDiagonalMovementActions[direction - DIR_SOUTHWEST], 0);
+    }
+    return TRUE;
+}
