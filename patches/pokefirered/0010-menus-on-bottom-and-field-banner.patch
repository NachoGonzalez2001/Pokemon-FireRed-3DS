+
+static void BuildSpriteLists(void)
+{
+    sObjCount[0] = sObjCount[1] = sObjCount[2] = sObjCount[3] = 0;
+    for (int i = 127; i >= 0; i--)
+    {
+        struct OamData *oam = &((struct OamData *)OAM)[i];
+        int height, y;
+
+        if (oam->objMode == 2 || oam->shape == 3)
+            continue;
+        if (!(oam->affineMode & 1) && (oam->affineMode & 2))
+            continue;               // a non-affine sprite with bit 9: hidden
+        height = oam->shape == 0 ? (8 << oam->size)
+               : oam->shape == 1 ? spriteSizes[oam->size][0] : spriteSizes[oam->size][1];
+        if ((oam->affineMode & 1) && (oam->affineMode & 2))
+            height *= 2;            // an affine sprite's double size
+        y = oam->y;
+        if (y >= DISPLAY_HEIGHT)
+            y -= 256;
+        if (y + height <= 0 || y >= DISPLAY_HEIGHT)
+            continue;
+        sObjTop[i] = y;
+        sObjBottom[i] = y + height;
+        sObjList[oam->priority][sObjCount[oam->priority]++] = i;
+    }
+}
