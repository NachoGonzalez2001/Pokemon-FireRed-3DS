+#ifdef PORT_BRIDGE
+// 3DS port: the camera moved a pixel at a time. Its tile changes as it leaves
+// a tile's grid line or comes back onto it, which a frame's whole movement
+// only meets when it moves by a step's even pixels; free movement
+// (field_player_avatar.c) moves by any, and turns round anywhere.
+static void CameraStep(int movementSpeedX, int movementSpeedY)
+{
+    int deltaX = 0;
+    int deltaY = 0;
+
+    if (gFieldCamera.x == 0 && movementSpeedX != 0)
+        deltaX = movementSpeedX > 0 ? 1 : -1;
+    if (gFieldCamera.y == 0 && movementSpeedY != 0)
+        deltaY = movementSpeedY > 0 ? 1 : -1;
+    if (gFieldCamera.x != 0 && gFieldCamera.x == -movementSpeedX)
+        deltaX = movementSpeedX > 0 ? 1 : -1;
+    if (gFieldCamera.y != 0 && gFieldCamera.y == -movementSpeedY)
+        deltaY = movementSpeedY > 0 ? 1 : -1;
+
+    gFieldCamera.x += movementSpeedX;
+    gFieldCamera.x = gFieldCamera.x - 16 * (gFieldCamera.x / 16);
+    gFieldCamera.y += movementSpeedY;
+    gFieldCamera.y = gFieldCamera.y - 16 * (gFieldCamera.y / 16);
+
+    if (deltaX != 0 || deltaY != 0)
+    {
+        CameraMove(deltaX, deltaY);
+        UpdateObjectEventsForCameraUpdate(deltaX, deltaY);
+        tilemap_move_something(&sFieldCameraOffset, deltaX * 2, deltaY * 2);
+        RedrawMapSlicesForCameraUpdate(&sFieldCameraOffset, deltaX * 2, deltaY * 2);
+    }
+
+    coords8_add(&sFieldCameraOffset, movementSpeedX, movementSpeedY);
+    gTotalCameraPixelOffsetX -= movementSpeedX;
+    gTotalCameraPixelOffsetY -= movementSpeedY;
+}
+
+void CameraUpdate(void)
+{
+    int speedX, speedY;
+
+    if (gFieldCamera.callback != NULL)
+        gFieldCamera.callback(&gFieldCamera);
+    speedX = gFieldCamera.movementSpeedX;
+    speedY = gFieldCamera.movementSpeedY;
+    while (speedX != 0 || speedY != 0)
+    {
+        int stepX = speedX > 0 ? 1 : speedX < 0 ? -1 : 0;
+        int stepY = speedY > 0 ? 1 : speedY < 0 ? -1 : 0;
+
+        CameraStep(stepX, stepY);
+        speedX -= stepX;
+        speedY -= stepY;
+    }
+}
+#else
 void CameraUpdate(void)
 {
     int deltaX;
