+    if (CtrPlayer_FreeStick(&sx, &sy))
+    {
+        float length = sqrtf((float)sx * sx + (float)sy * sy);
+        float pace = (length - FREE_STICK_SLOW) / (FREE_STICK_FULL - FREE_STICK_SLOW);
+
+        if (pace < 0.35f)
+            pace = 0.35f;
+        if (pace > 1.0f)
+            pace = 1.0f;
+        // the stick's y is up, the screen's down
+        *vx = (s32)(256.0f * pace * sx / length);
+        *vy = (s32)(-256.0f * pace * sy / length);
+        return;
+    }
+    *vx = (heldKeys & DPAD_RIGHT) ? 256 : (heldKeys & DPAD_LEFT) ? -256 : 0;
+    *vy = (heldKeys & DPAD_DOWN) ? 256 : (heldKeys & DPAD_UP) ? -256 : 0;
+    if (*vx != 0 && *vy != 0)
+    {
+        *vx = *vx * 181 / 256;
+        *vy = *vy * 181 / 256;
+    }
