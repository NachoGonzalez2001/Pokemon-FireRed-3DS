+    if (vx != 0 && facing == horizontal && ax * 4 >= ay * 3)
+        return horizontal;
+    if (vy != 0 && facing == vertical && ay * 4 >= ax * 3)
+        return vertical;
+    return ax > ay ? horizontal : vertical;
+}
