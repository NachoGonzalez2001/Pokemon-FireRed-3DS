+    view->species = sNamingScreen->monSpecies;
+    view->gender = sNamingScreen->monGender;
+    view->personality = sNamingScreen->monPersonality;
+    view->title = sNamingScreen->template->title;
+    view->keys = sKeyboardChars[CurrentPageToKeyboardId()][0];
+    memcpy(view->text, sNamingScreen->textBuffer, sizeof(view->text));
+    return TRUE;
+}
