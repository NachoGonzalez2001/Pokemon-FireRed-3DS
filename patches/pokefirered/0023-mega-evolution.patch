+/* ------------------------------------------------------------------------ */
+/* The form's numbers                                                       */
+/* ------------------------------------------------------------------------ */
+
+static u16 FormStat(struct Pokemon *mon, const struct MegaForm *form, u8 stat)
+{
+    s32 iv = GetMonData(mon, MON_DATA_HP_IV + stat);
+    s32 ev = GetMonData(mon, MON_DATA_HP_EV + stat);
+    s32 level = GetMonData(mon, MON_DATA_LEVEL);
+    s32 n = (2 * form->stats[stat] + iv + ev / 4) * level / 100 + 5;
+    u8 nature = GetNature(mon);
+
+    /* natures: nature / 5 raises, nature % 5 lowers (Atk, Def, Speed, SpAtk, SpDef) */
+    if (nature / 5 != nature % 5)
+    {
+        if (nature / 5 == stat - 1)
+            n = n * 110 / 100;
+        else if (nature % 5 == stat - 1)
+            n = n * 90 / 100;
+    }
+    return n;
+}
+
+/* gBattleMons takes the form's stats, types and ability (stat stages, HP
+ * and status stay). */
+void Mega_RefreshStats(u8 battler)
+{
+    s8 f = FormOf(battler);
+    struct Pokemon *mon;
+    const struct MegaForm *form;
+
+    if (f < 0 || gBattleMons[battler].species != sForms[f].species)
+        return;
+    mon = BattlerMon(battler);
+    form = &sForms[f];
+    gBattleMons[battler].attack = FormStat(mon, form, STAT_ATK);
+    gBattleMons[battler].defense = FormStat(mon, form, STAT_DEF);
+    gBattleMons[battler].speed = FormStat(mon, form, STAT_SPEED);
+    gBattleMons[battler].spAttack = FormStat(mon, form, STAT_SPATK);
+    gBattleMons[battler].spDefense = FormStat(mon, form, STAT_SPDEF);
+    gBattleMons[battler].type1 = form->types[0];
+    gBattleMons[battler].type2 = form->types[1];
+    gBattleMons[battler].ability = form->ability;
+}
+
+/* A Pokémon sent back in keeps its form for the rest of the battle. */
+void Mega_OnSwitchIn(u8 battler)
+{
+    Mega_RefreshStats(battler);
+}
