+/*
+ * Mega Evolution (3DS port).
+ *
+ * A Pokémon holding a Mega Stone, whose trainer has the Key Stone, can Mega
+ * Evolve once per battle: at the start of the turn, before anyone moves. The
+ * form exists only in this file's battle state. The party data, and so the
+ * save, never changes: gBattleMons gets the form's stats, types and ability,
+ * the battler's sprite gets the form's picture, and both are put back on the
+ * party Pokémon's own values by the next battle.
+ */
+#include "global.h"
+#include "battle.h"
+#include "battle_anim.h"
+#include "battle_controllers.h"
+#include "battle_gfx_sfx_util.h"
+#include "battle_mega.h"
+#include "battle_message.h"
+#include "battle_scripts.h"
+#include "battle_util.h"
+#include "event_data.h"
+#include "item.h"
+#include "palette.h"
+#include "pokemon.h"
+#include "sound.h"
+#include "sprite.h"
+#include "string_util.h"
+#include "util.h"
+#include "constants/abilities.h"
+#include "constants/battle_move_effects.h"
+#include "constants/moves.h"
+#include "constants/pokemon.h"
+#include "constants/battle_string_ids.h"
+#include "constants/songs.h"
+#include "constants/species.h"
+
+/* fr_mega_art.c (generated by tools/dev/mega_sprites.py) */
+extern const u32 gMegaPics[MEGA_FORM_COUNT][2][0x200];
+extern const u16 gMegaPalettes[MEGA_FORM_COUNT][2][16];
+
+struct MegaForm
+{
+    u16 species;
+    bool8 y;              /* the form a MEGA STONE Y gives */
+    u8 ability;
+    u8 types[2];
+    u8 stats[NUM_STATS];  /* HP, Atk, Def, Speed, Sp. Atk, Sp. Def */
+    const u8 *name;
+};
+
+static const u8 sName_Venusaur[] = _("MEGA VENUSAUR");
+static const u8 sName_CharizardX[] = _("MEGA CHARIZARD X");
+static const u8 sName_CharizardY[] = _("MEGA CHARIZARD Y");
+static const u8 sName_Blastoise[] = _("MEGA BLASTOISE");
+static const u8 sName_Beedrill[] = _("MEGA BEEDRILL");
+static const u8 sName_Pidgeot[] = _("MEGA PIDGEOT");
+static const u8 sName_Alakazam[] = _("MEGA ALAKAZAM");
+static const u8 sName_Slowbro[] = _("MEGA SLOWBRO");
+static const u8 sName_Gengar[] = _("MEGA GENGAR");
+static const u8 sName_Kangaskhan[] = _("MEGA KANGASKHAN");
+static const u8 sName_Pinsir[] = _("MEGA PINSIR");
+static const u8 sName_Gyarados[] = _("MEGA GYARADOS");
+static const u8 sName_Aerodactyl[] = _("MEGA AERODACTYL");
+static const u8 sName_MewtwoX[] = _("MEGA MEWTWO X");
+static const u8 sName_MewtwoY[] = _("MEGA MEWTWO Y");
+
+static const struct MegaForm sForms[MEGA_FORM_COUNT] =
+{
+    [MEGA_FORM_VENUSAUR]    = { SPECIES_VENUSAUR,   FALSE, ABILITY_THICK_FAT,     { TYPE_GRASS,   TYPE_POISON },   { 80, 100, 123,  80, 122, 120 }, sName_Venusaur },
+    [MEGA_FORM_CHARIZARD_X] = { SPECIES_CHARIZARD,  FALSE, ABILITY_TOUGH_CLAWS,   { TYPE_FIRE,    TYPE_DRAGON },   { 78, 130, 111, 100, 130,  85 }, sName_CharizardX },
+    [MEGA_FORM_CHARIZARD_Y] = { SPECIES_CHARIZARD,  TRUE,  ABILITY_DROUGHT,       { TYPE_FIRE,    TYPE_FLYING },   { 78, 104,  78, 100, 159, 115 }, sName_CharizardY },
+    [MEGA_FORM_BLASTOISE]   = { SPECIES_BLASTOISE,  FALSE, ABILITY_MEGA_LAUNCHER, { TYPE_WATER,   TYPE_WATER },    { 79, 103, 120,  78, 135, 115 }, sName_Blastoise },
+    [MEGA_FORM_BEEDRILL]    = { SPECIES_BEEDRILL,   FALSE, ABILITY_ADAPTABILITY,  { TYPE_BUG,     TYPE_POISON },   { 65, 150,  40, 145,  15,  80 }, sName_Beedrill },
+    [MEGA_FORM_PIDGEOT]     = { SPECIES_PIDGEOT,    FALSE, ABILITY_NO_GUARD,      { TYPE_NORMAL,  TYPE_FLYING },   { 83,  80,  80, 121, 135,  80 }, sName_Pidgeot },
+    [MEGA_FORM_ALAKAZAM]    = { SPECIES_ALAKAZAM,   FALSE, ABILITY_TRACE,         { TYPE_PSYCHIC, TYPE_PSYCHIC },  { 55,  50,  65, 150, 175, 105 }, sName_Alakazam },
+    [MEGA_FORM_SLOWBRO]     = { SPECIES_SLOWBRO,    FALSE, ABILITY_SHELL_ARMOR,   { TYPE_WATER,   TYPE_PSYCHIC },  { 95,  75, 180,  30, 130,  80 }, sName_Slowbro },
+    [MEGA_FORM_GENGAR]      = { SPECIES_GENGAR,     FALSE, ABILITY_SHADOW_TAG,    { TYPE_GHOST,   TYPE_POISON },   { 60,  65,  80, 130, 170,  95 }, sName_Gengar },
+    [MEGA_FORM_KANGASKHAN]  = { SPECIES_KANGASKHAN, FALSE, ABILITY_PARENTAL_BOND, { TYPE_NORMAL,  TYPE_NORMAL },   {105, 125, 100, 100,  60, 100 }, sName_Kangaskhan },
+    [MEGA_FORM_PINSIR]      = { SPECIES_PINSIR,     FALSE, ABILITY_AERILATE,      { TYPE_BUG,     TYPE_FLYING },   { 65, 155, 120, 105,  65,  90 }, sName_Pinsir },
+    [MEGA_FORM_GYARADOS]    = { SPECIES_GYARADOS,   FALSE, ABILITY_MOLD_BREAKER,  { TYPE_WATER,   TYPE_DARK },     { 95, 155, 109,  81,  70, 130 }, sName_Gyarados },
+    [MEGA_FORM_AERODACTYL]  = { SPECIES_AERODACTYL, FALSE, ABILITY_TOUGH_CLAWS,   { TYPE_ROCK,    TYPE_FLYING },   { 80, 135,  85, 150,  70,  95 }, sName_Aerodactyl },
+    [MEGA_FORM_MEWTWO_X]    = { SPECIES_MEWTWO,     FALSE, ABILITY_STEADFAST,     { TYPE_PSYCHIC, TYPE_FIGHTING }, {106, 190, 100, 130, 154, 100 }, sName_MewtwoX },
+    [MEGA_FORM_MEWTWO_Y]    = { SPECIES_MEWTWO,     TRUE,  ABILITY_INSOMNIA,      { TYPE_PSYCHIC, TYPE_PSYCHIC },  {106, 150,  70, 140, 194, 120 }, sName_MewtwoY },
+};
+
+/* ------------------------------------------------------------------------ */
+/* Battle state: nothing here is ever saved                                 */
+/* ------------------------------------------------------------------------ */
+
+static EWRAM_DATA struct
+{
+    u8 form[2][PARTY_SIZE]; /* 1 + MEGA_FORM_*, 0 = none */
+    bool8 used[2];          /* one Mega Evolution per side and battle */
+    bool8 toggled[MAX_BATTLERS_COUNT];     /* the player's MEGA key this turn */
+    u8 evolving;                           /* the form being taken */
+    u8 step, timer;
+    u8 moldAttacker;                       /* Mold Breaker: who silenced abilities */
+    u8 moldSaved[MAX_BATTLERS_COUNT];
+    u16 moldSpecies[MAX_BATTLERS_COUNT];
+} sMega = {0};
+
+static struct Pokemon *BattlerMon(u8 battler)
+{
+    struct Pokemon *party = GetBattlerSide(battler) == B_SIDE_PLAYER ? gPlayerParty : gEnemyParty;
+
+    return &party[gBattlerPartyIndexes[battler]];
+}
+
+/* The battler's form, or -1. */
+static s8 FormOf(u8 battler)
+{
+    u8 f = sMega.form[GetBattlerSide(battler)][gBattlerPartyIndexes[battler] % PARTY_SIZE];
+
+    return f ? f - 1 : -1;
+}
+
+bool8 Mega_IsEvolved(u8 battler)
+{
+    return FormOf(battler) >= 0;
+}
+
+/* The form a Pokémon of this species takes holding this item, or -1. */
+static s8 FormFor(u16 species, u16 item)
+{
+    s8 first = -1;
+    int i;
+
+    if (item != ITEM_MEGA_STONE && item != ITEM_MEGA_STONE_Y)
+        return -1;
+    for (i = 0; i < MEGA_FORM_COUNT; i++)
+    {
+        if (sForms[i].species != species)
+            continue;
+        if (first < 0)
+            first = i;
+        if (sForms[i].y && item == ITEM_MEGA_STONE_Y)
+            return i;
+    }
+    return first;
+}
+
+static bool8 BattleAllowsMega(void)
+{
+    return !(gBattleTypeFlags & (BATTLE_TYPE_LINK | BATTLE_TYPE_SAFARI | BATTLE_TYPE_OLD_MAN_TUTORIAL
+                                 | BATTLE_TYPE_POKEDUDE | BATTLE_TYPE_FIRST_BATTLE | BATTLE_TYPE_GHOST));
+}
+
+static s8 FormIfCanEvolve(u8 battler)
+{
+    u8 side = GetBattlerSide(battler);
+
+    if (!BattleAllowsMega() || sMega.used[side] || FormOf(battler) >= 0)
+        return -1;
+    if (gBattleMons[battler].hp == 0 || (gBattleMons[battler].status2 & STATUS2_TRANSFORMED))
+        return -1;
+    if (side == B_SIDE_PLAYER ? !FlagGet(FLAG_MEGA_KEY_STONE) : !(gBattleTypeFlags & BATTLE_TYPE_TRAINER))
+        return -1;
+    if (gAbsentBattlerFlags & gBitTable[battler])
+        return -1;
+    return FormFor(GetMonData(BattlerMon(battler), MON_DATA_SPECIES), gBattleMons[battler].item);
+}
+
+#ifdef PORT_BRIDGE
+void CtrLog_Write(int category, const char *format, ...); /* 3ds_log.h; 5 = CTR_LOG_GAME */
+#define MEGA_LOG(...) CtrLog_Write(5, __VA_ARGS__)
+#else
+#define MEGA_LOG(...)
+#endif
+
+#ifdef CTR_DEBUG_MEGA
+/* Diagnostic (local.mk -DCTR_DEBUG_MEGA): every battle gives the player's lead
+ * the form CTR_DEBUG_MEGA_PLAYER (a species) with CTR_DEBUG_MEGA_ITEM, the
+ * Key Stone, the MEGA key lit each turn; a trainer's lead becomes
+ * CTR_DEBUG_MEGA_FOE holding a MEGA STONE. RAM only: the party goes back to
+ * the save's on the next load. */
+#ifndef CTR_DEBUG_MEGA_PLAYER
+#define CTR_DEBUG_MEGA_PLAYER SPECIES_CHARIZARD
+#endif
