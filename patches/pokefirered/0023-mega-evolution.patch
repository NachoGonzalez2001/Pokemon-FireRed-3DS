+/* megaevolve battler, phase: phase 0 is the change itself (a flash to white,
+ * the new picture, the flash back, its cry); phase 1 its ability on entry. */
+void Mega_Cmd(void)
+{
+    u8 battler, side;
+    u16 offset;
+
+    if (gBattleControllerExecFlags)
+        return;
+    battler = GetBattlerForBattleScript(gBattlescriptCurrInstr[1]);
+    side = GetBattlerSide(battler);
+    offset = OBJ_PLTT_ID(battler);
+    if (gBattlescriptCurrInstr[2] == 1)
+    {
+        gBattlescriptCurrInstr += 3;
+        if (!AbilityBattleEffects(ABILITYEFFECT_ON_SWITCHIN, battler, 0, 0, 0))
+            AbilityBattleEffects(ABILITYEFFECT_TRACE, 0, 0, 0, 0);
+        return;
+    }
+    switch (sMega.step)
+    {
+    case 0:
+        sMega.form[side][gBattlerPartyIndexes[battler] % PARTY_SIZE] = sMega.evolving + 1;
+        sMega.used[side] = TRUE;
+        Mega_RefreshStats(battler);
+        PlaySE(SE_M_MEGA_KICK);
+        sMega.timer = 0;
+        sMega.step++;
+        break;
+    case 1:
+        sMega.timer++;
+        BlendPalette(offset, 16, sMega.timer, RGB_WHITE);
+        if (sMega.timer == 16)
+        {
+            LoadFormPicture(battler, sMega.evolving, TRUE);
+            LoadFormPalette(battler, sMega.evolving);
+            BlendPalette(offset, 16, 16, RGB_WHITE);
+            PlaySE(SE_SHINY);
+            sMega.step++;
+        }
+        break;
+    case 2:
+        sMega.timer--;
+        BlendPalette(offset, 16, sMega.timer, RGB_WHITE);
+        if (sMega.timer == 0)
+        {
+            CpuCopy32(&gPlttBufferUnfaded[offset], &gPlttBufferFaded[offset], PLTT_SIZE_4BPP);
+            PlayCry_Normal(gBattleMons[battler].species, side == B_SIDE_PLAYER ? -25 : 25);
+            sMega.timer = 0;
+            sMega.step++;
+        }
+        break;
+    default:
+        if (++sMega.timer < 40)
+            break;
+        sMega.step = 0;
+        gBattlescriptCurrInstr += 3;
+        break;
+    }
+}
