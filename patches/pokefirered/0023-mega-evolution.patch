+/* ------------------------------------------------------------------------ */
+/* The forms' abilities                                                     */
+/* ------------------------------------------------------------------------ */
+
+static bool8 IsAerilated(u8 battlerAtk, u16 move)
+{
+    return gBattleMons[battlerAtk].ability == ABILITY_AERILATE
+        && gBattleMoves[move].type == TYPE_NORMAL && gBattleMoves[move].power != 0
+        && move != MOVE_STRUGGLE
+        && gBattleMoves[move].effect != EFFECT_HIDDEN_POWER && gBattleMoves[move].effect != EFFECT_WEATHER_BALL;
+}
+
+/* Tough Claws, Mega Launcher, Aerilate: a move's power (CalculateBaseDamage). */
+u16 Mega_ModifyPower(u8 battlerAtk, u16 move, u16 power)
+{
+    switch (gBattleMons[battlerAtk].ability)
+    {
+    case ABILITY_TOUGH_CLAWS:
+        if (gBattleMoves[move].flags & FLAG_MAKES_CONTACT)
+            power = power * 130 / 100;
+        break;
+    case ABILITY_MEGA_LAUNCHER:
+        if (move == MOVE_WATER_PULSE)
+            power = power * 150 / 100;
+        break;
+    case ABILITY_AERILATE:
+        if (IsAerilated(battlerAtk, move))
+            power = power * 130 / 100;
+        break;
+    }
+    return power;
+}
+
+/* Parental Bond: the parent and its child both hit. The second hit's quarter
+ * comes with the first, as one blow (single-target moves that hit once). */
+s32 Mega_ModifyDamage(u8 battlerAtk, u16 move, s32 damage)
+{
+    u8 effect = gBattleMoves[move].effect;
+
+    if (gBattleMons[battlerAtk].ability != ABILITY_PARENTAL_BOND || gBattleMoves[move].power == 0)
+        return damage;
+    if (gBattleMoves[move].target & (MOVE_TARGET_BOTH | MOVE_TARGET_FOES_AND_ALLY))
+        return damage;
+    if (effect == EFFECT_MULTI_HIT || effect == EFFECT_DOUBLE_HIT || effect == EFFECT_TRIPLE_KICK
+     || effect == EFFECT_TWINEEDLE || effect == EFFECT_BEAT_UP || effect == EFFECT_EXPLOSION)
+        return damage;
+    return damage + damage / 4;
+}
+
+/* Adaptability: same-type moves twice as strong instead of half again. */
+u8 Mega_StabTenths(u8 battlerAtk)
+{
+    return gBattleMons[battlerAtk].ability == ABILITY_ADAPTABILITY ? 20 : 15;
+}
+
+bool8 Mega_NoGuard(u8 battlerAtk, u8 battlerDef)
+{
+    return gBattleMons[battlerAtk].ability == ABILITY_NO_GUARD || gBattleMons[battlerDef].ability == ABILITY_NO_GUARD;
+}
+
+/* Abilities that Mold Breaker's moves go through (those FireRed has). */
+static const u8 sMoldBroken[] =
+{
+    ABILITY_BATTLE_ARMOR, ABILITY_CLEAR_BODY, ABILITY_DAMP, ABILITY_FLASH_FIRE, ABILITY_HYPER_CUTTER,
+    ABILITY_IMMUNITY, ABILITY_INNER_FOCUS, ABILITY_INSOMNIA, ABILITY_KEEN_EYE, ABILITY_LEVITATE,
+    ABILITY_LIGHTNING_ROD, ABILITY_LIMBER, ABILITY_MAGMA_ARMOR, ABILITY_MARVEL_SCALE, ABILITY_OBLIVIOUS,
+    ABILITY_OWN_TEMPO, ABILITY_SAND_VEIL, ABILITY_SHELL_ARMOR, ABILITY_SHIELD_DUST, ABILITY_SOUNDPROOF,
+    ABILITY_STICKY_HOLD, ABILITY_STURDY, ABILITY_SUCTION_CUPS, ABILITY_THICK_FAT, ABILITY_VITAL_SPIRIT,
+    ABILITY_VOLT_ABSORB, ABILITY_WATER_ABSORB, ABILITY_WATER_VEIL, ABILITY_WHITE_SMOKE, ABILITY_WONDER_GUARD,
+};
+
+/* The start of a move (HandleAction_UseMove): Aerilate's type, and Mold
+ * Breaker silencing the others' abilities until the move is over. */
+void Mega_BeforeMove(void)
+{
+    u8 battler, i;
+
+    if (IsAerilated(gBattlerAttacker, gCurrentMove) && gBattleStruct->dynamicMoveType == 0)
+        gBattleStruct->dynamicMoveType = TYPE_FLYING | F_DYNAMIC_TYPE_2;
+    if (gBattleMons[gBattlerAttacker].ability != ABILITY_MOLD_BREAKER)
+        return;
+    sMega.moldAttacker = gBattlerAttacker + 1;
+    for (battler = 0; battler < gBattlersCount; battler++)
+    {
+        sMega.moldSaved[battler] = ABILITY_NONE;
+        if (battler == gBattlerAttacker)
+            continue;
+        for (i = 0; i < ARRAY_COUNT(sMoldBroken); i++)
+            if (gBattleMons[battler].ability == sMoldBroken[i])
+            {
+                sMega.moldSaved[battler] = gBattleMons[battler].ability;
+                sMega.moldSpecies[battler] = gBattleMons[battler].species;
+                gBattleMons[battler].ability = ABILITY_NONE;
+                break;
+            }
+    }
+}
+
+/* The move is over: the silenced abilities come back (to the same Pokémon). */
+void Mega_AfterMove(void)
+{
+    u8 battler;
+
+    if (!sMega.moldAttacker)
+        return;
+    sMega.moldAttacker = 0;
+    for (battler = 0; battler < gBattlersCount; battler++)
+    {
+        if (sMega.moldSaved[battler] != ABILITY_NONE && gBattleMons[battler].ability == ABILITY_NONE
+         && gBattleMons[battler].species == sMega.moldSpecies[battler])
+            gBattleMons[battler].ability = sMega.moldSaved[battler];
+        sMega.moldSaved[battler] = ABILITY_NONE;
+    }
+}
+
+/* Steadfast: flinching raises Speed. TRUE when it does (the caller runs
+ * BattleScript_SteadfastFlinched). */
+bool8 Mega_Steadfast(u8 battler)
+{
+    if (gBattleMons[battler].ability != ABILITY_STEADFAST || gBattleMons[battler].statStages[STAT_SPEED] >= MAX_STAT_STAGE)
+        return FALSE;
+    gBattleMons[battler].statStages[STAT_SPEED]++;
+    gBattleScripting.animArg1 = 14 + STAT_SPEED;
+    gBattleScripting.animArg2 = 0;
+    gBattleScripting.battler = battler;
+    return TRUE;
+}
