+/* ------------------------------------------------------------------------ */
+/* The turn                                                                 */
+/* ------------------------------------------------------------------------ */
+
+/* Before the turn's first action: the next Pokémon (in turn order) that
+ * Mega Evolves runs BattleScript_MegaEvolution. The player chooses with the
+ * MEGA key; a trainer's Pokémon always does when it can. */
+bool8 Mega_TryStartTurn(void)
+{
+    int i;
+
+    for (i = 0; i < gBattlersCount; i++)
+    {
+        u8 battler = gBattlerByTurnOrder[i];
+        s8 f;
+
+        if (gChosenActionByBattler[battler] != B_ACTION_USE_MOVE)
+            continue;
+        if (GetBattlerSide(battler) == B_SIDE_PLAYER && !sMega.toggled[battler])
+            continue;
+        f = FormIfCanEvolve(battler);
+        if (f < 0)
+            continue;
+        sMega.toggled[battler] = FALSE;
+        sMega.evolving = f;
+        sMega.step = 0;
+        gBattlerAttacker = gActiveBattler = battler;
+        gLastUsedItem = gBattleMons[battler].item;
+        MEGA_LOG("mega: battler %u (species %u) takes form %d", battler, gBattleMons[battler].species, f);
+        BattleScriptExecute(BattleScript_MegaEvolution);
+        return TRUE;
+    }
+    Mega_TurnDone();
+    return FALSE;
+}
+
+void Mega_TurnDone(void)
+{
+    memset(sMega.toggled, 0, sizeof(sMega.toggled));
+#ifdef CTR_DEBUG_MEGA
+    sMega.toggled[0] = TRUE;
+#endif
+}
